# Copy to .env and fill in real values (this file is safe to commit).

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"
SESSION_SECRET="use-a-long-random-string"
JWT_SECRET="use-a-long-random-string"

# Optional. Localhost Vite origins are always allowed in dev.
# Comma-separated: add every browser origin that may call this API (prod + previews, etc.).
# CLIENT_ORIGIN=https://workoutdb-beta.vercel.app,https://workout-db-beta-git-main-you.vercel.app
# Second slot if you prefer to keep LAN mobile separate from web:
# CLIENT_ORIGIN_MOBILE=http://YOUR_LAN_IP:5173

# PORT=3000

# Comma-separated emails allowed to GET /feedback (dev review). Leave unset to disable listing.
# FEEDBACK_REVIEWER_EMAILS=you@example.com

# AI connector (MCP) - canonical public URL of the MCP endpoint. Dev fallback: http://localhost:3000/mcp
# MCP_RESOURCE_URL=https://workout-db-l3gc.onrender.com/mcp
# WorkOS API key (SECRET - server-side only; never expose to the client).
# WORKOS_API_KEY=sk_example
# WorkOS client ID (not secret).
# WORKOS_CLIENT_ID=client_example
# AuthKit domain / authorization server issuer URL.
# MCP_AUTHORIZATION_SERVER=https://api.workos.com/authkit/...

# In-app coach (ai-layer.md Lane B). ONE code path, two key sources: a user's
# own Anthropic key encrypted in UserCoachKey, or this hosted key for entitled
# users. This is the APP's provider key - a deliberate app-billing choice.
# Leave unset to keep the coach off. COACH_PROVIDER=mock streams a canned
# answer with no key at all (local dev / staging before a key exists).
#
# Hosted coach ships on a Cursor API key. A stored BYO key stays Anthropic
# (`sk-ant-...`) and forces that provider. The browser never holds the key.
#
# COACH_KEY_SECRET encrypts saved BYO keys (AES-256-GCM). 32 random bytes,
# base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Unset or invalid: PUT /coach/key returns 503 byo_unavailable. Rotating this
# value invalidates every saved key; users re-enter them.
# COACH_KEY_SECRET=
# COACH_PROVIDER=cursor
# COACH_API_KEY=<Cursor user API key>
# COACH_MODEL=auto
# COACH_EFFORT=medium
#
# Legacy hosted-Anthropic shape (still accepted):
# COACH_PROVIDER=anthropic
# COACH_API_KEY=sk-ant-...
# COACH_MODEL=claude-sonnet-5
#
# Hosted-coach weekly cap: 7 questions per rolling 7 days. Comma-separated
# emails skip the cap (case-insensitive). Unset or empty means nobody is exempt.
# BYO-key and mock-provider questions are never counted.
# COACH_UNCAPPED_EMAILS=you@example.com
